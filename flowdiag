#!/usr/bin/env python3
"""Проверка, снимки и версия без JavaScript для HTML-схемы из template.html.

  flowdiag check    схема.html   перекрытия блоков, стрелки через блоки, подписи, id, переключатель темы
  flowdiag shot     схема.html   снимки PNG в светлой и тёмной теме
  flowdiag nojs     схема.html   фрагмент <style> + разметка: координаты в px, стрелки из div и span
  flowdiag sanitize схема.nojs.html   прогон через санитайзер по умолчанию из @diplodoc/html-extension

Нужен Chrome или Chromium, путь задаёт переменная CHROME. Для sanitize нужны npm и Node 22.12+, путь задаёт NODE.
"""
import argparse
import glob
import html
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
TOOLS = HERE / "flowdiag.js"
SANITIZER = Path(os.environ.get("FLOWDIAG_CACHE", Path.home() / ".cache" / "flowdiag")) / "sanitizer"
SANITIZER_PACKAGES = ["@diplodoc/html-extension@2.9.7", "@diplodoc/transform@^4"]


def find_chrome():
    home = Path.home()
    candidates = [
        os.environ.get("CHROME"),
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
        "/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary",
        *sorted(glob.glob(str(home / "Library/Caches/ms-playwright/chromium_headless_shell-*/*/chrome-headless-shell")), reverse=True),
        *sorted(glob.glob(str(home / ".cache/ms-playwright/chromium_headless_shell-*/*/chrome-headless-shell")), reverse=True),
        "/Applications/Chromium.app/Contents/MacOS/Chromium",
        shutil.which("google-chrome"),
        shutil.which("chromium"),
        shutil.which("chromium-browser"),
    ]
    for c in candidates:
        if c and os.access(c, os.X_OK):
            return c
    sys.exit("flowdiag: Chrome или Chromium не найден; укажите путь в переменной CHROME")


def chrome(args, tmp, timeout=60):
    exe = find_chrome()
    cmd = [
        exe, "--headless", "--disable-gpu", "--hide-scrollbars", "--no-first-run",
        "--no-default-browser-check", f"--user-data-dir={tmp}/profile", "--virtual-time-budget=5000", *args,
    ]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        sys.exit(f"flowdiag: {exe} не ответил за {timeout} с; укажите другой браузер в переменной CHROME")
    if res.returncode != 0:
        sys.exit(f"flowdiag: браузер завершился с кодом {res.returncode}\n{res.stderr[-2000:]}")
    return res.stdout


def as_page(src):
    if re.search(r"<html|<body", src, re.I):
        return src
    return f'<!DOCTYPE html>\n<html lang="ru"><head><meta charset="utf-8"></head><body style="margin:0">\n{src}\n</body></html>\n'


def inject(src, script):
    page = as_page(src)
    i = page.lower().rfind("</body>")
    return page[:i] + script + page[i:] if i >= 0 else page + script


def evaluate(src, mode, opts=None, width=1280):
    script = f"<script>\n{TOOLS.read_text(encoding='utf-8')}\nflowdiagRun({json.dumps(mode)}, {json.dumps(opts or {})});\n</script>\n"
    with tempfile.TemporaryDirectory() as tmp:
        page = Path(tmp) / "page.html"
        page.write_text(inject(src, script), encoding="utf-8")
        out = chrome(["--dump-dom", f"--window-size={width},1000", page.as_uri()], tmp)
    m = re.search(r"<body[^>]*>(.*)</body>", out, re.S)
    try:
        data = json.loads(html.unescape(m.group(1)) if m else "")
    except ValueError:
        sys.exit("flowdiag: браузер не вернул результат; проверьте, что скрипт из template.html на месте")
    if "error" in data:
        sys.exit(f"flowdiag: ошибка в странице: {data['error']}")
    return data


def report(problems):
    for p in problems:
        print(f"  {p}")
    return 1 if problems else 0


def stem(path):
    return path.name[:-5] if path.name.endswith(".html") else path.name


def cmd_check(a):
    data = evaluate(a.file.read_text(encoding="utf-8"), "check", width=a.width)
    s = data["stats"]
    head = f"схемы: {s['diagrams']}, блоки: {s['blocks']}, стрелки: {s['edges']}, высота: {s['height']} px"
    print(f"{'ok' if not data['problems'] else 'есть замечания'}: {head}")
    return report(data["problems"])


def cmd_shot(a):
    src = a.file.read_text(encoding="utf-8")
    out_dir = a.out_dir or a.file.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    height = min(evaluate(src, "measure", width=a.width)["height"], 16000)
    themes = ["light", "dark"] if a.theme == "both" else [a.theme]
    for theme in themes:
        # Radio inputs belong to the no-JS version, setTheme to the template script.
        script = (f"<script>(function (t) {{ var r = document.getElementById('fd-' + t), F = window.flowDiagram;"
                  f" if (r) r.checked = true; else if (F && F.setTheme) F.setTheme(t); }})({json.dumps(theme)});</script>\n")
        out = out_dir / f"{stem(a.file)}.{theme}.png"
        with tempfile.TemporaryDirectory() as tmp:
            page = Path(tmp) / "page.html"
            page.write_text(inject(src, script), encoding="utf-8")
            chrome([f"--screenshot={out.resolve()}", f"--window-size={a.width},{height}", page.as_uri()], tmp)
        print(f"{out} ({a.width}×{height})")
    return 0


def cmd_nojs(a):
    data = evaluate(a.file.read_text(encoding="utf-8"), "nojs", {"width": a.width})
    out = a.out or a.file.with_name(f"{stem(a.file)}.nojs.html")
    out.write_text(data["html"], encoding="utf-8")
    s = data["stats"]
    scripts = len(re.findall(r"<script", data["html"], re.I))
    print(f"{out}: схемы: {s['diagrams']}, блоки: {s['blocks']}, линии: {s['lines']}, наконечники: {s['heads']}, "
          f"подписи: {s['labels']}, скрипты: {scripts}, высота: {s['height']} px")
    return report(data["problems"])


def node_version(exe):
    try:
        v = subprocess.run([exe, "-p", "process.versions.node"], capture_output=True, text=True, timeout=20).stdout.strip()
        return tuple(int(x) for x in v.split(".")[:2])
    except (OSError, ValueError, subprocess.SubprocessError):
        return (0, 0)


def find_node():
    home = Path.home()
    candidates = [os.environ.get("NODE"), shutil.which("node")]
    for pattern in (".local/share/nvm/v*/bin/node", ".nvm/versions/node/v*/bin/node"):
        candidates += sorted(glob.glob(str(home / pattern)), key=lambda p: node_version(p), reverse=True)
    for c in candidates:
        if c and os.access(c, os.X_OK) and node_version(c) >= (22, 12):
            return c
    sys.exit("flowdiag: нужен Node 22.12+ (пакет санитайзера загружает ES-модули через require); путь задаёт NODE")


def cmd_sanitize(a):
    node = find_node()
    if not (SANITIZER / "node_modules/@diplodoc/html-extension").is_dir():
        SANITIZER.mkdir(parents=True, exist_ok=True)
        npm = shutil.which("npm") or sys.exit("flowdiag: нужен npm для установки санитайзера")
        print(f"установка {' '.join(SANITIZER_PACKAGES)} в {SANITIZER}")
        subprocess.run([npm, "install", "--prefix", str(SANITIZER), "--no-audit", "--no-fund", "--silent", *SANITIZER_PACKAGES], check=True)
    out = a.out or a.file.with_name(f"{stem(a.file)}.sanitized.html")
    js = ("const fs = require('fs'), s = require('@diplodoc/html-extension').htmlBlockDefaultSanitizer;"
          "fs.writeFileSync(process.argv[2], s.body(fs.readFileSync(process.argv[1], 'utf8')));")
    subprocess.run([node, "-e", js, str(a.file.resolve()), str(out.resolve())], cwd=SANITIZER, check=True)
    before, after = a.file.read_text(encoding="utf-8"), out.read_text(encoding="utf-8")
    marks = ['class="bx', "edge-line", "edge-head", "edge-label", 'type="radio"', 'for="fd-', "<style", "@media", "<script"]
    lost = [f"{m}: {before.count(m)} → {after.count(m)}" for m in marks if before.count(m) != after.count(m)]
    tags_b = Counter(t.lower() for t in re.findall(r"<([a-zA-Z][\w-]*)", before))
    tags_a = Counter(t.lower() for t in re.findall(r"<([a-zA-Z][\w-]*)", after))
    lost += [f"<{t}>: {n} → {tags_a[t]}" for t, n in sorted(tags_b.items()) if tags_a[t] != n]
    print(f"{out}: {'без потерь' if not lost else 'изменилось'}")
    for line in lost:
        print(f"  {line}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="flowdiag", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("check", help="проверить раскладку")
    s.add_argument("--width", type=int, default=1280, help="ширина окна в px")
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser("shot", help="снимки PNG")
    s.add_argument("--width", type=int, default=1280, help="ширина окна в px")
    s.add_argument("--theme", choices=["both", "light", "dark"], default="both")
    s.add_argument("--out-dir", type=Path, help="папка для PNG; по умолчанию папка схемы")
    s.set_defaults(fn=cmd_shot)

    s = sub.add_parser("nojs", help="версия без JavaScript")
    s.add_argument("--width", type=int, default=1040, help="ширина схемы в px")
    s.add_argument("-o", "--out", type=Path)
    s.set_defaults(fn=cmd_nojs)

    s = sub.add_parser("sanitize", help="прогон через санитайзер")
    s.add_argument("-o", "--out", type=Path)
    s.set_defaults(fn=cmd_sanitize)

    for s in sub.choices.values():
        s.add_argument("file", type=Path)
    a = p.parse_args()
    if not a.file.is_file():
        sys.exit(f"flowdiag: нет файла {a.file}")
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
